        "import tensorflow as tf\n",
        "from tensorflow.keras import layers, Model\n",
        "\n",
        "NUM_CHARACTERS = len(characters)\n",
        "\n",
        "# Input image\n",
        "image_input = layers.Input(\n",
        "    shape=(IMG_HEIGHT, IMG_WIDTH, 1),\n",
        "    name=\"image\"\n",
        ")\n",
        "\n",
        "# CNN feature extraction\n",
        "x = layers.Conv2D(\n",
        "    32, (3, 3),\n",
        "    activation=\"relu\",\n",
        "    padding=\"same\"\n",
        ")(image_input)\n",
        "\n",
        "x = layers.MaxPooling2D((2, 2))(x)\n",
        "\n",
        "x = layers.Conv2D(\n",
        "    64, (3, 3),\n",
        "    activation=\"relu\",\n",
        "    padding=\"same\"\n",
        ")(x)\n",
        "\n",
        "x = layers.MaxPooling2D((2, 2))(x)\n",
        "\n",
        "x = layers.Conv2D(\n",
        "    128, (3, 3),\n",
        "    activation=\"relu\",\n",
        "    padding=\"same\"\n",
        ")(x)\n",
        "\n",
        "# Convert CNN features into a sequence\n",
        "# Shape after CNN: (batch, 12, 50, 128)\n",
        "x = layers.Permute((2, 1, 3))(x)\n",
        "\n",
        "x = layers.Reshape(\n",
        "    (IMG_WIDTH // 4, (IMG_HEIGHT // 4) * 128)\n",
        ")(x)\n",
        "\n",
        "# Sequence learning\n",
        "x = layers.Bidirectional(\n",
        "    layers.LSTM(\n",
        "        128,\n",
        "        return_sequences=True\n",
        "    )\n",
        ")(x)\n",
        "\n",
        "x = layers.Bidirectional(\n",
        "    layers.LSTM(\n",
        "        64,\n",
        "        return_sequences=True\n",
        "    )\n",
        ")(x)\n",
        "\n",
        "# Character probabilities\n",
        "output = layers.Dense(\n",
        "    NUM_CHARACTERS + 1,\n",
        "    activation=\"softmax\",\n",
        "    name=\"output\"\n",
        ")(x)\n",
        "\n",
        "prediction_model = Model(\n",
        "    image_input,\n",
        "    output\n",
        ")\n",
        "\n",
        "prediction_model.summary()"
