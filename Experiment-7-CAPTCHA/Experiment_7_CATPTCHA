        "input_layer = Input(\n",
        "    shape=(IMG_HEIGHT, IMG_WIDTH, 1)\n",
        ")\n",
        "\n",
        "x = Conv2D(\n",
        "    32, (3, 3),\n",
        "    activation=\"relu\",\n",
        "    padding=\"same\"\n",
        ")(input_layer)\n",
        "\n",
        "x = BatchNormalization()(x)\n",
        "x = MaxPooling2D((2, 2))(x)\n",
        "\n",
        "x = Conv2D(\n",
        "    64, (3, 3),\n",
        "    activation=\"relu\",\n",
        "    padding=\"same\"\n",
        ")(x)\n",
        "\n",
        "x = BatchNormalization()(x)\n",
        "x = MaxPooling2D((2, 2))(x)\n",
